# Skopiuj do .env i zmień wartości. Plik .env nie trafia do gita.
JWT_SECRET=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki
# Baza danych z portfelem. Hasło: długi losowy ciąg z liter i cyfr (trafia do adresu połączenia).
# Zmiana hasła po pierwszym uruchomieniu wymaga też ALTER USER w bazie — samo .env nie zmienia hasła istniejącej bazy.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=zmien-mnie-na-losowy-ciag
POSTGRES_DB=portfolio
# open: każdy może założyć konto (tylko lokalnie); invite: konto tylko z kodem z INVITE_CODES (domyślnie).
REGISTRATION_MODE=open
INVITE_CODES=
# Za Cloudflare Tunnel: CF-Connecting-IP (tylko gdy API jest dostępne wyłącznie przez tunel).
CLIENT_IP_HEADER=
